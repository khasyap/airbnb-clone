<svg xmlns="http://www.w3.org/2000/svg" width="960" height="720" viewBox="0 0 960 720">
  <rect width="960" height="720" fill="#fafafa"/>
  <text x="480" y="36" text-anchor="middle" font-family="system-ui,sans-serif" font-size="20" font-weight="700" fill="#222">Vacation Rental Marketplace — Production Architecture</text>

  <!-- User -->
  <rect x="420" y="55" width="120" height="36" rx="8" fill="#222"/>
  <text x="480" y="78" text-anchor="middle" font-family="system-ui" font-size="13" fill="#fff">USER</text>
  <line x1="480" y1="91" x2="480" y2="110" stroke="#666" stroke-width="1.5"/>

  <!-- CDN -->
  <rect x="360" y="110" width="240" height="40" rx="8" fill="#e8f4fd" stroke="#3b82f6" stroke-width="1.5"/>
  <text x="480" y="135" text-anchor="middle" font-family="system-ui" font-size="13" font-weight="600" fill="#1e40af">CDN / Edge + WAF</text>
  <line x1="480" y1="150" x2="480" y2="170" stroke="#666" stroke-width="1.5"/>

  <!-- Web App -->
  <rect x="360" y="170" width="240" height="40" rx="8" fill="#dcfce7" stroke="#22c55e" stroke-width="1.5"/>
  <text x="480" y="195" text-anchor="middle" font-family="system-ui" font-size="13" font-weight="600" fill="#166534">Web Application (React / SSR)</text>
  <line x1="480" y1="210" x2="480" y2="230" stroke="#666" stroke-width="1.5"/>

  <!-- API Gateway -->
  <rect x="340" y="230" width="280" height="40" rx="8" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.5"/>
  <text x="480" y="255" text-anchor="middle" font-family="system-ui" font-size="13" font-weight="600" fill="#92400e">API Gateway / Load Balancer</text>

  <!-- Lines to services -->
  <line x1="400" y1="270" x2="160" y2="310" stroke="#666" stroke-width="1"/>
  <line x1="440" y1="270" x2="320" y2="310" stroke="#666" stroke-width="1"/>
  <line x1="480" y1="270" x2="480" y2="310" stroke="#666" stroke-width="1"/>
  <line x1="520" y1="270" x2="640" y2="310" stroke="#666" stroke-width="1"/>
  <line x1="560" y1="270" x2="800" y2="310" stroke="#666" stroke-width="1"/>

  <!-- Microservices row 1 -->
  <rect x="80" y="310" width="140" height="50" rx="6" fill="#fff" stroke="#6366f1" stroke-width="1.5"/>
  <text x="150" y="340" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#3730a3">Auth Service</text>

  <rect x="250" y="310" width="140" height="50" rx="6" fill="#fff" stroke="#6366f1" stroke-width="1.5"/>
  <text x="320" y="332" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#3730a3">Listing Service</text>
  <text x="320" y="348" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">CRUD · media</text>

  <rect x="420" y="310" width="140" height="50" rx="6" fill="#fff" stroke="#6366f1" stroke-width="1.5"/>
  <text x="490" y="332" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#3730a3">Search Service</text>
  <text x="490" y="348" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">OpenSearch</text>

  <rect x="590" y="310" width="140" height="50" rx="6" fill="#fff" stroke="#6366f1" stroke-width="1.5"/>
  <text x="660" y="332" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#3730a3">Booking Service</text>
  <text x="660" y="348" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Reservations</text>

  <rect x="760" y="310" width="140" height="50" rx="6" fill="#fff" stroke="#6366f1" stroke-width="1.5"/>
  <text x="830" y="332" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#3730a3">Payment Service</text>
  <text x="830" y="348" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Stripe etc.</text>

  <!-- Row 2 services -->
  <rect x="80" y="390" width="140" height="50" rx="6" fill="#fff" stroke="#8b5cf6" stroke-width="1.5"/>
  <text x="150" y="412" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#5b21b6">User Service</text>
  <text x="150" y="428" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Profiles</text>

  <rect x="250" y="390" width="140" height="50" rx="6" fill="#fff" stroke="#8b5cf6" stroke-width="1.5"/>
  <text x="320" y="412" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#5b21b6">Review Service</text>
  <text x="320" y="428" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Ratings</text>

  <rect x="420" y="390" width="140" height="50" rx="6" fill="#fff" stroke="#8b5cf6" stroke-width="1.5"/>
  <text x="490" y="412" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#5b21b6">Media Service</text>
  <text x="490" y="428" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">S3 + CDN</text>

  <rect x="590" y="390" width="140" height="50" rx="6" fill="#fff" stroke="#8b5cf6" stroke-width="1.5"/>
  <text x="660" y="412" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#5b21b6">Pricing Service</text>
  <text x="660" y="428" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Dynamic</text>

  <rect x="760" y="390" width="140" height="50" rx="6" fill="#fff" stroke="#8b5cf6" stroke-width="1.5"/>
  <text x="830" y="412" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#5b21b6">Notify / Msg</text>
  <text x="830" y="428" text-anchor="middle" font-family="system-ui" font-size="10" fill="#666">Events</text>

  <!-- Data layer -->
  <line x1="480" y1="440" x2="480" y2="470" stroke="#666" stroke-width="1.5"/>
  <rect x="120" y="470" width="720" height="100" rx="10" fill="#f1f5f9" stroke="#64748b" stroke-width="1.5"/>
  <text x="480" y="495" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="#334155">Data Layer</text>

  <rect x="140" y="510" width="120" height="40" rx="6" fill="#fff" stroke="#64748b"/>
  <text x="200" y="535" text-anchor="middle" font-family="system-ui" font-size="11" fill="#334155">PostgreSQL</text>

  <rect x="280" y="510" width="100" height="40" rx="6" fill="#fff" stroke="#64748b"/>
  <text x="330" y="535" text-anchor="middle" font-family="system-ui" font-size="11" fill="#334155">Redis</text>

  <rect x="400" y="510" width="120" height="40" rx="6" fill="#fff" stroke="#64748b"/>
  <text x="460" y="535" text-anchor="middle" font-family="system-ui" font-size="11" fill="#334155">OpenSearch</text>

  <rect x="540" y="510" width="100" height="40" rx="6" fill="#fff" stroke="#64748b"/>
  <text x="590" y="535" text-anchor="middle" font-family="system-ui" font-size="11" fill="#334155">S3 / Blob</text>

  <rect x="660" y="510" width="150" height="40" rx="6" fill="#fff" stroke="#64748b"/>
  <text x="735" y="535" text-anchor="middle" font-family="system-ui" font-size="11" fill="#334155">Kafka / Events</text>

  <!-- Infra -->
  <text x="480" y="610" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="#555">Infrastructure: Kubernetes · CI/CD · Observability · Secrets · Multi-region · Backups</text>
  <text x="480" y="640" text-anchor="middle" font-family="system-ui" font-size="11" fill="#777">Read path: CDN → App → Gateway → Listing (Redis cache) → Postgres / Media</text>
  <text x="480" y="660" text-anchor="middle" font-family="system-ui" font-size="11" fill="#777">Booking: Lock (Redis) → Payment → Write reservation → Event bus → Notify</text>
  <text x="480" y="690" text-anchor="middle" font-family="system-ui" font-size="11" fill="#777">Search: Event-driven index to OpenSearch · geo + facet filters</text>
</svg>
